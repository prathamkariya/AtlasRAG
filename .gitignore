.venv/
.env
__pycache__/
*.pyc
*.pyo
*.bak
*.log

# PDFs, indexes and embeddings are rebuilt from metadata.jsonl / chunks.jsonl (see scripts/refetch_pdfs.py,
# scripts/rebuild_index_from_chunks.py); they never go in Git.
data/raw*/pdf/
data/retrieval/
data/index*/
*.npy
# LLM cache: only the Run 1 namespace is tracked (reproducibility of Run 1); new namespaces stay local.
data/llm_cache/*
!data/llm_cache/default/
*.patch
audit_*view*.txt

_patch_*/
*.zip

data/bench/*pilot*.jsonl

.vscode/
audit_report.txt
sections.csv
